# TrustVault — Automated Test Environment Configuration
#
# Copy this file to .env.test to configure a dedicated, isolated test database.
#
# SECURITY RULES:
# 1. Automated integration tests will FAIL CLOSED and refuse execution if TEST_DATABASE_URL
#    is missing or points to a non-test database.
# 2. Never point TEST_DATABASE_URL to your development or production database.
# 3. For local PostgreSQL, the database name must contain "test" (e.g. trustvault_test).
# 4. For remote cloud databases, the database name must contain "test" AND
#    TRUSTVAULT_TEST_DB_CONFIRMED=true must be set.

# Dedicated disposable/local test database connection string
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustvault_test

# Confirmation flag required only when running tests against dedicated cloud test databases
# TRUSTVAULT_TEST_DB_CONFIRMED=true

# Isolated test storage bucket (in-memory driver is used by default in tests)
TEST_STORAGE_BUCKET=trustvault-test-isolated
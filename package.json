{
  "name": "trustvault",
  "version": "1.0.0",
  "private": true,
  "description": "Secure document sharing with per-document authorization and an auditable access trail",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:api && npm run build:web",
    "test": "npm run test --workspace=apps/api",
    "test:unit": "npm run test:unit --workspace=apps/api",
    "test:integration": "npm run test:integration --workspace=apps/api",
    "typecheck:api": "npm run typecheck --workspace=apps/api",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "typecheck": "npm run typecheck:api && npm run typecheck:web"
  },
  "engines": {
    "node": ">=22"
  }
}
NODE_ENV=development
PORT=4000

DATABASE_URL=your_supabase_postgres_connection_string

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=your_server_side_secret_key

FRONTEND_ORIGIN=http://localhost:5173

SESSION_SECRET=your_generated_random_secret_min_32_chars

SUPABASE_STORAGE_BUCKET=trustvault-private

# Demo Account Provisioning (For Evaluation)
# Set ENABLE_DEMO_ACCOUNTS=true and configure passwords (min 12 chars).
# Standard evaluation default passwords:
ENABLE_DEMO_ACCOUNTS=true
DEMO_ADMIN_PASSWORD=AdminDemo2026!
DEMO_OWNER_PASSWORD=OwnerDemo2026!
DEMO_VIEWER_PASSWORD=ViewerDemo2026!

# Optional custom demo emails (defaults shown):
# DEMO_ADMIN_EMAIL=admin@trustvault.local
# DEMO_OWNER_EMAIL=owner@trustvault.local
# DEMO_VIEWER_EMAIL=viewer@trustvault.local

# Required ONLY if provisioning demo accounts in a production deployment:
# DEMO_ENV_CONFIRMATION=false